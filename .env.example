# Copy to .env to override defaults. Placeholder values only — Mate needs no API keys.

# --- Model gateway -----------------------------------------------------------
# Which live model the agents use: "gemini" (Gemini API free tier, default) or "ollama" (local open-weight).
MODEL_PROVIDER=gemini

# Gemini API (Google AI Studio). Free key: https://aistudio.google.com/apikey
# Put the real key only in your untracked .env file, never in this file or in git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 0 = no "thinking" (faster, less quota); -1 = model default.
GEMINI_THINKING_BUDGET=0
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_RETRIES=2
# Free-tier rate limits: retries after HTTP 429, waiting up to this many seconds each time.
GEMINI_RATE_LIMIT_RETRIES=2
GEMINI_MAX_RATE_LIMIT_WAIT_SECONDS=60

# Local Ollama server (MODEL_PROVIDER=ollama; start with: docker compose --profile ollama up). Inside docker compose this is the "ollama" service.
# To use an Ollama already running on your machine instead:
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
# Model tag pulled by the ollama-pull bootstrap service and used by every agent.
OLLAMA_MODEL=qwen3.5:9b
# Seconds before a single model call is abandoned (CPU inference can be slow).
OLLAMA_TIMEOUT_SECONDS=240
# Attempts for a structured (JSON-schema) response before the call is reported as failed.
OLLAMA_MAX_RETRIES=2
# Qwen3-family models can "think" before answering; Mate asks for direct answers by default.
OLLAMA_THINK=false
# Sampling temperature for agents (used by both providers).
OLLAMA_TEMPERATURE=0.4

# --- Application -------------------------------------------------------------
# Default mode offered for new ventures: "live" (the model above) or "demo" (scripted, no model).
# Demo ventures are labelled DEMO everywhere; live failures are never replaced by demo output.
MATE_DEFAULT_MODE=live
# SQLite database location (inside the backend container this lives on the mate_data volume).
DATABASE_URL=sqlite:////app/data/mate.db
# Where runtime agent actions are appended (one JSON entry per agent action).
DECISION_LOG_PATH=/app/data/decision_log.json
# Where generated artifacts (MVP starter files, landing pages) are written.
ARTIFACTS_DIR=/app/data/artifacts
# Allowed browser origins for the API (comma separated).
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Research ----------------------------------------------------------------
# Free, keyless public sources (World Bank Indicators API, Wikipedia REST API).
# Set to false to force the explicit degraded (no retrieval) mode.
RESEARCH_ONLINE=true
RESEARCH_TIMEOUT_SECONDS=8
RESEARCH_USER_AGENT=MateResearchBot/0.1 (open-source hackathon project; contact: maintainers@example.org)

# --- Ports (host side) ---------------------------------------------------------
FRONTEND_PORT=8080
BACKEND_PORT=8000
